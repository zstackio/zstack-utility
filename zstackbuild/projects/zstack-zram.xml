<?xml version="1.0" encoding="UTF-8"?>

<project name="zstack-zram RPM builder" basedir="../">
    <property name="zstackzram.go" value="/usr/lib/golang1.24/bin/go" />
    <property name="zstackzram.stage.dir" location="${build.dir}/zstack-zram-rpm-stage" />
    <property name="zstackzram.rpm.input.dir" location="${build.dir}/zstack-zram-rpm-input" />
    <property name="zstackzram.rpm.input" location="${zstackzram.rpm.input.dir}/zstack-zram.rpm" />
    <property name="zstackzram.rpm.cpio" location="${zstackzram.rpm.input.dir}/zstack-zram.cpio" />
    <property name="zstackzram.rpm.manifest" location="${zstackzram.rpm.input.dir}/BUILD-MANIFEST.json" />
    <property name="zstackzram.metadata.file" location="${build.dir}/zstack-zram-build/metadata.properties" />
    <property name="zstackzram.snapshot.dir" location="${build.dir}/build-metadata/zstack-zram-source" />
    <condition property="zstackzram.enabled">
        <equals arg1="${zstackzram.targetArch}" arg2="x86_64" casesensitive="false" />
    </condition>

    <target name="build-zstack-zram-rpm" if="zstackzram.enabled">
        <checkFile file="${zstackzram.go}" />
        <!-- The metadata and RPM scripts refuse existing outputs; a rerun replaces only what this target wrote. -->
        <delete dir="${zstackzram.snapshot.dir}" quiet="true" />
        <delete file="${zstackzram.metadata.file}" quiet="true" />
        <exec executable="/bin/python" failonerror="true">
            <env key="GO" value="${zstackzram.go}" />
            <env key="GOROOT" value="" />
            <arg value="${zstackutility.source}/zstackbuild/scripts/prepare_zstack_zram_build_metadata.py" />
            <arg value="--source-checkout" /><arg value="${zstackzram.checkout}" />
            <arg value="--snapshot-dir" /><arg value="${zstackzram.snapshot.dir}" />
            <arg value="--output" /><arg value="${zstackzram.metadata.file}" />
            <arg value="--host-profiles" /><arg value="${zstackzram.hostProfiles}" />
            <arg value="--target-arch" /><arg value="${zstackzram.targetArch}" />
        </exec>
        <property file="${zstackzram.metadata.file}" />
        <checkProperty property="zstackzram.frozenSource" />
        <checkProperty property="zstackzram.sourceSnapshotManifest" />
        <checkProperty property="zstackzram.sourceSnapshotSha256" />
        <checkProperty property="zstackzram.sourceRevision" />
        <checkProperty property="zstackzram.dirtyPatchSha256" />
        <checkProperty property="zstackzram.sourceDirty" />
        <checkProperty property="zstackzram.rpm.output" />
        <checkProperty property="zstackzram.version" />
        <checkProperty property="zstackzram.release" />
        <checkProperty property="zstackzram.sourceDateEpoch" />
        <checkProperty property="zstackzram.hostProfiles" />
        <checkProperty property="zstackzram.buildEnvironmentId" />
        <checkFile file="${zstackzram.frozenSource}/packaging/build-rpm.sh" />
        <checkFile file="${zstackzram.sourceSnapshotManifest}" />
        <delete dir="${zstackzram.rpm.output}" quiet="true" />
        <!-- build-rpm.sh verifies the pinned manifest itself before packaging. -->
        <exec executable="${zstackzram.frozenSource}/packaging/build-rpm.sh"
              dir="${zstackzram.frozenSource}" failonerror="true">
            <env key="GO" value="${zstackzram.go}" />
            <env key="GOROOT" value="" />
            <arg value="--output" /><arg value="${zstackzram.rpm.output}" />
            <arg value="--version" /><arg value="${zstackzram.version}" />
            <arg value="--release" /><arg value="${zstackzram.release}" />
            <arg value="--source-date-epoch" /><arg value="${zstackzram.sourceDateEpoch}" />
            <arg value="--source-revision" /><arg value="${zstackzram.sourceRevision}" />
            <arg value="--source-dirty" /><arg value="${zstackzram.sourceDirty}" />
            <arg value="--source-snapshot-manifest" /><arg value="${zstackzram.sourceSnapshotManifest}" />
            <arg value="--source-snapshot-sha256" /><arg value="${zstackzram.sourceSnapshotSha256}" />
            <arg value="--dirty-patch-sha256" /><arg value="${zstackzram.dirtyPatchSha256}" />
            <arg value="--build-environment-id" /><arg value="${zstackzram.buildEnvironmentId}" />
        </exec>
    </target>

    <target name="stage-zstack-zram-rpm" if="zstackzram.enabled">
        <checkProperty property="zstackzram.rpm.url" />
        <checkProperty property="zstackzram.rpm.sha256" />
        <delete dir="${zstackzram.rpm.input.dir}" />
        <mkdir dir="${zstackzram.rpm.input.dir}" />
        <get src="${zstackzram.rpm.url}" dest="${zstackzram.rpm.input}" usetimestamp="false" />
        <echo file="${zstackzram.rpm.input.dir}/rpm.sha256">${zstackzram.rpm.sha256}  ${zstackzram.rpm.input}</echo>
        <exec executable="sha256sum" failonerror="true">
            <arg value="--check" />
            <arg value="${zstackzram.rpm.input.dir}/rpm.sha256" />
        </exec>
        <!-- Keep the RPM payload byte-for-byte: Ant's output redirector is text-oriented. -->
        <exec executable="/bin/bash" failonerror="true">
            <arg value="-c" />
            <arg value='rpm2cpio "$1" &gt; "$2"' />
            <arg value="ant-rpm2cpio" />
            <arg value="${zstackzram.rpm.input}" />
            <arg value="${zstackzram.rpm.cpio}" />
        </exec>
        <exec executable="/bin/bash" failonerror="true">
            <arg value="-c" />
            <arg value='cpio -i --quiet --to-stdout ./usr/share/doc/zstack-zram/BUILD-MANIFEST.json &lt; "$1" &gt; "$2"' />
            <arg value="ant-extract-zstack-zram-manifest" />
            <arg value="${zstackzram.rpm.cpio}" />
            <arg value="${zstackzram.rpm.manifest}" />
        </exec>
        <delete dir="${zstackzram.stage.dir}" />
        <exec executable="/bin/python" failonerror="true">
            <arg value="${zstackutility.source}/kvmagent/scripts/stage_memory_optimization_rpm.py" />
            <arg value="--rpm" /><arg value="${zstackzram.rpm.input}" />
            <arg value="--build-manifest" /><arg value="${zstackzram.rpm.manifest}" />
            <arg value="--output" /><arg value="${zstackzram.stage.dir}" />
            <arg value="--host-profiles" /><arg value="${zstackzram.hostProfiles}" />
            <arg value="--installer-script" />
            <arg value="${zstackutility.source}/kvmagent/scripts/install_memory_optimization_rpm.py" />
        </exec>
    </target>

    <target name="assemble-zstack-zram-rpm" depends="stage-zstack-zram-rpm" if="zstackzram.enabled">
        <!-- KVM assembly clears its destination after dependencies run. Stage
             beside the other KVM inputs, which deployModule copies unchanged. -->
        <delete dir="${kvmagent.bdir}/ansible/memory-optimization/zstack-zram" />
        <copy todir="${kvmagent.bdir}/ansible/memory-optimization/zstack-zram">
            <fileset dir="${zstackzram.stage.dir}">
                <include name="BUILD-MANIFEST.json" />
                <include name="rpm-inventory.json" />
                <include name="install_memory_optimization_rpm.py" />
            </fileset>
        </copy>
    </target>
</project>
